---
/** Wordmark built from individual letters so they can fall / bounce independently. */
const { word = 'ASCELCAFE', cls = '' } = Astro.props;
---
<span class={`wm ${cls}`} aria-label="Ascelcafe" role="img" data-wm>
	{word.split('').map((c) => <span class="wm__l" aria-hidden="true">{c}</span>)}
	<span class="wm__a" aria-hidden="true">
		<svg viewBox="0 0 40 56"><ellipse cx="20" cy="28" rx="16" ry="25" fill="currentColor" /><path d="M20 5c-9 10 9 22 0 46" fill="none" stroke="var(--wm-groove, #B4173A)" stroke-width="4" stroke-linecap="round" /></svg>
	</span>
</span>
